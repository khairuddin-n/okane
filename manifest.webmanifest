{
  "name": "okane",
  "short_name": "okane",
  "description": "Simple daily money tracker. Your data stays in your own Google Sheet.",
  "lang": "en",
  "start_url": "./#/beranda",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F3F6F5",
  "theme_color": "#1F4FB8",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add expense", "short_name": "Expense", "url": "./#/catat?tipe=keluar", "icons": [{ "src": "./icons/sc-keluar.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Add income", "short_name": "Income", "url": "./#/catat?tipe=masuk", "icons": [{ "src": "./icons/sc-masuk.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Transfer", "short_name": "Transfer", "url": "./#/catat?tipe=transfer", "icons": [{ "src": "./icons/sc-transfer.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
